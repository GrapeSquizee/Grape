{
  "_comment": "은행별 계좌번호 형식(하이픈 포함 표기 기준). 근사 패턴이므로 PoC 검증 후 실데이터 기준으로 보정할 것. generic 패턴은 문맥 키워드와 함께 쓰일 때만 신뢰.",
  "patterns": [
    {"bank": "국민",   "regex": "(?<![\\d-])\\d{6}-\\d{2}-\\d{6}(?![\\d-])"},
    {"bank": "신한",   "regex": "(?<![\\d-])11[0-5]-\\d{3}-\\d{6}(?![\\d-])"},
    {"bank": "우리",   "regex": "(?<![\\d-])100[2-8]-\\d{3}-\\d{6}(?![\\d-])"},
    {"bank": "하나",   "regex": "(?<![\\d-])\\d{3}-\\d{6}-\\d{5}(?![\\d-])"},
    {"bank": "농협",   "regex": "(?<![\\d-])3\\d{2}-\\d{4}-\\d{4}-\\d{2}(?![\\d-])"},
    {"bank": "기업",   "regex": "(?<![\\d-])\\d{3}-\\d{6}-\\d{2}-\\d{3}(?![\\d-])"},
    {"bank": "카카오뱅크", "regex": "(?<![\\d-])3333-\\d{2}-\\d{7}(?![\\d-])"},
    {"bank": "generic", "regex": "(?<![\\d-])\\d{3,6}-\\d{2,6}-\\d{4,7}(?![\\d-])"}
  ]
}
